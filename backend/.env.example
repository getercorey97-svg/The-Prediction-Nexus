# ==============================================================================
# The Prediction Nexus: Environment Configuration
# ==============================================================================

# Application Port & Host
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Redis Broker (for Celery background tasks)
REDIS_URL=redis://localhost:6379/0

# Supabase PostgreSQL Database Connection
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Free Sport Ingestion API Keys (Optional - Ingestors automatically fall back to verified empirical caches when unset)
CFBD_API_KEY=your_free_college_football_data_api_key
ODDS_API_KEY=your_free_the_odds_api_key
LIVE_TENNIS_API_KEY=your_free_live_tennis_api_key
